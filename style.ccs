* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background: #090909;
  color: #ffffff;
  padding: 0 0 80px 0;
  min-height: 100vh;
  -webkit-tap-highlight-color: transparent;
  user-select: none;
}

#app {
  max-width: 480px;
  margin: 0 auto;
  padding: 0 16px 16px;
}

/* TOPBAR */
.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 0 12px;
  position: sticky;
  top: 0;
  background: #090909;
  z-index: 10;
}

.brand {
  font-size: 18px;
  font-weight: 700;
  letter-spacing: 0.5px;
  color: #fff;
}

.subtitle {
  font-size: 12px;
  color: #888;
  margin-top: 2px;
}

.icon-button {
  background: none;
  border: none;
  color: #fff;
  padding: 8px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.icon-button svg {
  width: 24px;
  height: 24px;
}

/* SEARCH */
.search-section {
  padding: 0 0 16px;
}

.search-section input {
  width: 100%;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid #2a2a2a;
  background: #141414;
  color: #fff;
  font-size: 16px;
  outline: none;
}

.search-section input::placeholder {
  color: #666;
}

.search-section input:focus {
  border-color: #444;
}

/* PAGES */
.page {
  display: none;
  padding: 12px 0 16px;
}

.page.active {
  display: block;
}

/* SECTION HEADING */
.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14px;
}

.section-heading h2 {
  font-size: 20px;
  font-weight: 600;
}

.section-heading button {
  background: none;
  border: none;
  color: #888;
  font-size: 14px;
  cursor: pointer;
}

/* PAGE TITLE */
.page-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
}

.page-title-row h1 {
  font-size: 22px;
  font-weight: 700;
}

.add-button {
  background: none;
  border: none;
  color: #fff;
  padding: 4px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-button svg {
  width: 28px;
  height: 28px;
}

/* BACK BUTTON */
.back-button {
  display: flex;
  align-items: center;
  gap: 6px;
  background: none;
  border: none;
  color: #888;
  font-size: 15px;
  cursor: pointer;
  margin-bottom: 16px;
  padding: 4px 0;
}

.back-button svg {
  width: 24px;
  height: 24px;
}

/* SONG ITEM */
.song-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #141414;
  margin-bottom: 8px;
  transition: 0.2s;
}

.song-item:active {
  transform: scale(0.98);
  background: #1a1a1a;
}

.song-cover {
  background: none;
  border: none;
  color: #fff;
  padding: 4px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.song-cover svg {
  width: 24px;
  height: 24px;
}

.song-info {
  flex: 1;
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 0;
  min-width: 0;
}

.song-title {
  font-size: 15px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-meta {
  font-size: 13px;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.song-actions {
  display: flex;
  gap: 6px;
  flex-shrink: 0;
}

.song-actions button {
  background: none;
  border: none;
  color: #666;
  font-size: 18px;
  cursor: pointer;
  padding: 4px 6px;
  transition: 0.2s;
}

.song-actions button:active {
  transform: scale(0.9);
}

.song-actions .liked {
  color: #ff4757;
}

.song-actions button svg {
  width: 20px;
  height: 20px;
}

.playlist-song-item {
  position: relative;
}

.delete-song-from-playlist {
  background: none;
  border: none;
  cursor: pointer;
  padding: 4px;
  flex-shrink: 0;
}

.delete-song-from-playlist svg {
  width: 20px;
  height: 20px;
}

/* LIBRARY ITEM */
.library-item {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 14px 16px;
  border-radius: 12px;
  background: #141414;
  border: none;
  color: #fff;
  cursor: pointer;
  transition: 0.2s;
  text-align: left;
}

.library-item:active {
  transform: scale(0.98);
  background: #1a1a1a;
}

.library-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.library-icon svg {
  width: 28px;
  height: 28px;
}

.library-info {
  flex: 1;
  min-width: 0;
}

.library-name {
  font-size: 15px;
  font-weight: 500;
}

.library-meta {
  font-size: 13px;
  color: #888;
}

.library-arrow {
  color: #444;
  flex-shrink: 0;
}

.library-arrow svg {
  width: 24px;
  height: 24px;
}

/* PLAYLIST ITEM WITH DELETE */
.playlist-item-wrapper {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.delete-playlist-btn {
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  flex-shrink: 0;
  opacity: 0.6;
  transition: 0.2s;
}

.delete-playlist-btn:active {
  transform: scale(0.9);
  opacity: 1;
}

.create-first-btn {
  display: flex;
  align-items: center;
  gap: 10px;
  background: none;
  border: none;
  color: #888;
  font-size: 16px;
  cursor: pointer;
  padding: 12px;
}

.create-first-btn svg {
  width: 28px;
  height: 28px;
}

/* LOADING & EMPTY */
.loading,
.empty {
  text-align: center;
  color: #666;
  padding: 40px 0;
  font-size: 15px;
}

/* MINI PLAYER */
.mini-player {
  position: fixed;
  bottom: 72px;
  left: 16px;
  right: 16px;
  display: flex;
  align-items: center;
  gap: 12px;
  background: #1a1a1a;
  padding: 10px 14px;
  border-radius: 16px;
  backdrop-filter: blur(12px);
  box-shadow: 0 4px 20px rgba(0,0,0,0.8);
  z-index: 50;
  max-width: 448px;
  margin: 0 auto;
}

.mini-player.hidden {
  display: none;
}

.mini-cover {
  font-size: 24px;
  color: #fff;
  flex-shrink: 0;
}

.mini-info {
  flex: 1;
  min-width: 0;
  cursor: pointer;
}

.mini-title {
  font-size: 14px;
  font-weight: 500;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mini-artist {
  font-size: 12px;
  color: #888;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mini-like,
.mini-play {
  background: none;
  border: none;
  color: #fff;
  font-size: 20px;
  cursor: pointer;
  padding: 6px;
  flex-shrink: 0;
}

.mini-like:active,
.mini-play:active {
  transform: scale(0.9);
}

/* FULL PLAYER */
.player-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.85);
  backdrop-filter: blur(20px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
  padding: 24px;
}

.player-overlay.hidden {
  display: none;
}

.player {
  background: #121212;
  border-radius: 24px;
  padding: 32px 24px 28px;
  width: 100%;
  max-width: 400px;
  text-align: center;
  position: relative;
}

.player-close {
  position: absolute;
  top: 12px;
  left: 12px;
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 4px;
}

.player-close svg {
  width: 30px;
  height: 30px;
}

.player-cover {
  font-size: 64px;
  margin: 20px 0 16px;
}

.player-title {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 4px;
}

.player-artist {
  font-size: 15px;
  color: #888;
  margin-bottom: 20px;
}

.player input[type="range"] {
  width: 100%;
  -webkit-appearance: none;
  background: #2a2a2a;
  height: 4px;
  border-radius: 2px;
  outline: none;
}

.player input[type="range"]::-webkit-slider-thumb {
  -webkit-appearance: none;
  width: 14px;
  height: 14px;
  border-radius: 50%;
  background: #fff;
  cursor: pointer;
}

.time-row {
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #666;
  margin-top: 6px;
  margin-bottom: 20px;
}

.player-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 28px;
  margin-bottom: 20px;
}

.player-controls button {
  background: none;
  border: none;
  color: #fff;
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.player-controls button:active {
  transform: scale(0.9);
}

.player-controls button svg {
  width: 32px;
  height: 32px;
}

.main-play svg {
  width: 40px;
  height: 40px;
}

.player-extra {
  display: flex;
  justify-content: center;
  gap: 32px;
}

.player-extra button {
  background: none;
  border: none;
  color: #666;
  font-size: 20px;
  cursor: pointer;
  padding: 4px;
}

.player-extra button:active {
  transform: scale(0.9);
}

.player-extra button svg {
  width: 24px;
  height: 24px;
}

/* MODALS */
.modal {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.7);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
  padding: 24px;
}

.modal.hidden {
  display: none;
}

.modal-card {
  background: #1a1a1a;
  border-radius: 20px;
  padding: 28px 24px;
  width: 100%;
  max-width: 380px;
}

.modal-card h2 {
  font-size: 20px;
  margin-bottom: 16px;
}

.modal-card input {
  width: 100%;
  padding: 12px 16px;
  border-radius: 12px;
  border: 1px solid #2a2a2a;
  background: #0f0f0f;
  color: #fff;
  font-size: 16px;
  outline: none;
  margin-bottom: 16px;
}

.modal-card input::placeholder {
  color: #555;
}

.modal-card input:focus {
  border-color: #444;
}

.modal-actions {
  display: flex;
  gap: 10px;
}

.modal-actions button {
  flex: 1;
  padding: 12px;
  border-radius: 12px;
  border: none;
  font-size: 15px;
  font-weight: 500;
  cursor: pointer;
  transition: 0.2s;
}

.modal-actions button:active {
  transform: scale(0.97);
}

.primary-button {
  background: #fff;
  color: #000;
}

.secondary-button {
  background: #2a2a2a;
  color: #fff;
}

.full-button {
  width: 100%;
  margin-top: 12px;
}

/* BOTTOM NAV */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: #0d0d0d;
  border-top: 1px solid #1a1a1a;
  padding: 8px 0 12px;
  backdrop-filter: blur(12px);
  z-index: 60;
  max-width: 480px;
  margin: 0 auto;
}

.nav-item {
  background: none;
  border: none;
  color: #555;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  cursor: pointer;
  padding: 4px 12px;
  transition: 0.2s;
}

.nav-item svg {
  width: 24px;
  height: 24px;
  fill: currentColor;
}

.nav-item small {
  font-size: 10px;
  font-weight: 500;
}

.nav-item.active {
  color: #fff;
}

.nav-item:active {
  transform: scale(0.92);
}

/* DETAIL HEADER */
.detail-header {
  margin-bottom: 16px;
}

.detail-title {
  font-size: 22px;
  font-weight: 700;
}

.detail-subtitle {
  font-size: 14px;
  color: #888;
  margin-top: 2px;
}

/* SCROLLBAR */
::-webkit-scrollbar {
  width: 4px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: #2a2a2a;
  border-radius: 2px;
}

/* RESPONSIVE */
@media (max-width: 420px) {
  .topbar {
    padding: 12px 0 8px;
  }
  .brand {
    font-size: 16px;
  }
  .page {
    padding: 8px 0 12px;
  }
  .player {
    padding: 24px 16px 20px;
  }
}
